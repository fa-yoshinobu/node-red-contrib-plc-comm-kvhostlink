    {
        "id":  "prepare-kv-array-random",
        "type":  "function",
        "z":  "tab-kv-array",
        "name":  "Save arrays + choose random values",
        "func":  "const original = {\n    'DM160:U,4': Array.from(msg.payload['DM160:U,4']),\n    'R200:BIT,4': Array.from(msg.payload['R200:BIT,4'])\n};\nmsg.kvSampleOriginal = original;\nmsg.payload = {\n    'DM160:U,4': Array.from({ length: 4 }, function () { return Math.floor(Math.random() * 65536); }),\n    'R200:BIT,4': Array.from({ length: 4 }, function () { return Math.random() >= 0.5; })\n};\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [],
        "x":  680,
        "y":  180,
