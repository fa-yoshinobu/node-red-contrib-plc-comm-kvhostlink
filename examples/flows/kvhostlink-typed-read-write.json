    {
        "id":  "prepare-kv-typed-random",
        "type":  "function",
        "z":  "tab-kv-typed",
        "name":  "Save snapshot + choose random values",
        "func":  "const original = Object.assign({}, msg.payload);\nmsg.kvSampleOriginal = original;\nmsg.payload = {\n    'DM110:S': Math.floor(Math.random() * 65536) - 32768,\n    'DM120:D': Math.floor(Math.random() * 4294967296),\n    'DM130:L': Math.floor(Math.random() * 4294967296) - 2147483648,\n    'DM140:F': Math.fround((Math.random() * 2000) - 1000),\n    'DM150.3': !Boolean(original['DM150.3'])\n};\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [],
        "x":  700,
        "y":  180,
        "wires":  [
