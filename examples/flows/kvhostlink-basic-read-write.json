    {
        "id":  "prepare-kv-basic-random",
        "type":  "function",
        "z":  "tab-kv-basic",
        "name":  "Save original + choose random value",
        "func":  "const original = msg.payload;\nlet testValue = Math.floor(Math.random() * 65536);\nif (testValue === original) {\n    testValue = (testValue + 1) % 65536;\n}\nmsg.kvSampleOriginal = original;\nmsg.kvSampleTestValue = testValue;\nmsg.payload = { 'DM100:U': testValue };\nreturn msg;",
        "outputs":  1,
        "timeout":  0,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
        "libs":  [],
        "x":  700,
        "y":  180,
        "wires":  [
                      [
                          "write-kv-basic"
                      ]
                  ]
    },
    {
        "id":  "prepare-kv-basic-restore",
        "type":  "function",
        "z":  "tab-kv-basic",
        "name":  "Prepare original value restore",
        "func":  "msg.payload = { 'DM100:U': msg.kvSampleOriginal };\nreturn msg;",
        "outputs":  1,
